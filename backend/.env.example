# Apple Silicon local Whisper backend. First transcription downloads this model.
WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
OPENAI_WHISPER_MODEL=large-v3
WHISPER_TRANSLATION_MODEL=large-v3
INDIC_MODEL_ID=bodhan-ai/indic-transcribe-core
ASR_BACKEND=auto
MAX_AUDIO_MB=100
HOST=127.0.0.1
PORT=8000
# Optional: Hugging Face token after accepting the pyannote community-1 model terms.
# Keep the real token in your shell environment; never commit it to Git.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
